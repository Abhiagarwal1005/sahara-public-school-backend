# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every value is required — env.js checks them at
# boot and refuses to start if any are missing (failing immediately beats a
# silently broken deployment).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# Mongo Atlas — the cluster must be in the MUMBAI region. Functions run in
# bom1 (vercel.json); cross-region costs about 220ms on every query.
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/sps?retryWrites=true&w=majority

# JWT — keep these two different. Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Frontend origin, for CORS. Multiple origins can be comma-separated.
# If the frontend and API share a Vercel project, keep this the same origin.
FRONTEND_URL=http://localhost:5173

# Cloudinary — OPTIONAL. Leave all three blank and the app runs fine; bills and
# expenses are simply recorded without a photo, and the UI hides the upload box.
# Set all three to turn it on (partial config counts as off).
# Images go straight from the browser; the server only builds the signature,
# so the API secret never reaches the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sps

# Cookie — cross-site cookies in production need 'none'; on a same-origin
# deployment 'lax' is better and more secure.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
